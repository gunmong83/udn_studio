# ==========================================
# [로컬 개발 및 테스트용 환경변수 템플릿]
# 이 파일을 복사하여 web/.env.local 을 생성하세요.
# ==========================================

# NextAuth 인증 설정 (로컬 포트 3100 기준)
AUTH_SECRET=local-development-secret-key-at-least-32-chars-long
AUTH_URL=http://localhost:3100
AUTH_TRUST_HOST=true

# 로컬 SQLite 데이터베이스 경로
DATABASE_URL=file:../.local-stage-data/udn.db

# OAuth 소셜 로그인 (Google, Naver) - 개발자 콘솔에서 localhost:3100 리다이렉트 등록 필요
AUTH_GOOGLE_ID=your-google-client-id
AUTH_GOOGLE_SECRET=your-google-client-secret
AUTH_NAVER_ID=your-naver-client-id
AUTH_NAVER_SECRET=your-naver-client-secret

# NAVER Cloud SENS Biz Message (승인된 알림톡, SMS 서비스 ID와 다릅니다)
SENS_ALIMTALK_SERVICE_ID=ncp:kkobizmsg:kr:your-project:your-biz-message-service
SENS_ALIMTALK_CHANNEL_ID=@studioudn
SENS_ACCESS_KEY=your-ncloud-access-key
SENS_SECRET_KEY=your-ncloud-secret-key

# 우체국 국내우편물 종적조회 OpenAPI (발급받은 일반 인증키)
EPOST_SERVICE_KEY=your-epost-service-key
EPOST_POLLING_TOKEN=generate-a-long-random-secret

# 나이스페이 Server 승인 설정 (개발자센터의 클라이언트 키/시크릿 키)
NICEPAY_CLIENT_ID=replace-with-nicepay-client-key
NICEPAY_SECRET_KEY=replace-with-nicepay-secret-key
# 테스트 키(S2_...)는 샌드박스, 운영 키는 운영 API를 사용합니다. 필요하면 직접 지정하세요.
# NICEPAY_API_BASE_URL=https://sandbox-api.nicepay.co.kr/v1
