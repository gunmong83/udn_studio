generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  role          UserRole  @default(CUSTOMER)
  email         String?   @unique
  name          String?
  image         String?
  emailVerified DateTime?
  passwordHash  String?
  termsAgreedAt DateTime?
  privacyAgreedAt DateTime?
  phone         String?
  defaultRecipientName String?
  defaultPhone  String?
  defaultZonecode String?
  defaultAddress String?
  defaultAddressDetail String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  cartItems     CartItem[]
  orders        Order[]
}

// OAuth has authenticated the provider identity, but the member has not yet
// accepted Studio UDN's required terms. This is short-lived and deleted as
// soon as signup completes or expires.
model PendingOAuthSignup {
  id                String   @id @default(cuid())
  token             String   @unique
  provider          String
  providerAccountId String
  type              String
  email             String?
  name              String?
  image             String?
  refreshToken      String?
  accessToken       String?
  expiresAtProvider Int?
  tokenType         String?
  scope             String?
  idToken           String?
  sessionState      String?
  expiresAt         DateTime
  createdAt         DateTime @default(now())

  @@unique([provider, providerAccountId])
  @@index([expiresAt])
}

// Only HMAC-derived keys are stored. No raw email address or IP address is
// retained for request throttling.
model RequestRateLimit {
  key             String   @id
  count           Int      @default(0)
  windowStartedAt DateTime
  blockedUntil    DateTime?
  updatedAt       DateTime @updatedAt

  @@index([blockedUntil])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model CartItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  title     String
  price     Int
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model Order {
  id            String      @id @default(cuid())
  userId        String?
  status        OrderStatus @default(PENDING)
  paymentStatus PaymentStatus @default(UNPAID)
  paymentKey    String?     @unique
  totalAmount   Int
  recipientName String
  phone         String
  address       String
  addressDetail String?
  carrier       String?
  trackingNumber String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  user          User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  items         OrderItem[]
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  productId String
  title     String
  unitPrice Int
  quantity  Int
  order     Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

enum OrderStatus {
  PENDING
  PAID
  PREPARING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  UNPAID
  PAID
  FAILED
  REFUNDED
}

enum UserRole {
  CUSTOMER
  ADMIN
}

model AnalyticsSession {
  id             String              @id @default(cuid())
  visitorId      String
  referrer       String?
  referrerDomain String?
  entryPath      String
  device         String?             // mobile, desktop, tablet
  browser        String?             // Chrome, Safari, Whale, etc.
  os             String?             // iOS, Android, Windows, Mac, etc.
  duration       Int                 @default(0) // total dwell time in seconds
  pageCount      Int                 @default(1)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  pageviews      AnalyticsPageView[]

  @@index([createdAt])
  @@index([visitorId])
  @@index([referrerDomain])
}

model AnalyticsPageView {
  id        String           @id @default(cuid())
  sessionId String
  path      String
  title     String?
  duration  Int              @default(0) // dwell time on this page in seconds
  createdAt DateTime         @default(now())
  session   AnalyticsSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([path])
  @@index([createdAt])
  @@index([sessionId])
}
