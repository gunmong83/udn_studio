# ==========================================
# [AWS 프로덕션(운영) 배포용 환경변수 템플릿]
# Lightsail 서버의 /opt/udn_studio/.env.production 에 설정됩니다.
# ==========================================

# NextAuth 인증 설정 (실제 운영 도메인)
AUTH_SECRET=generate-a-strong-random-secret-key-for-production
AUTH_URL=https://studioundesignated.com
AUTH_TRUST_HOST=true

# 운영 Docker 볼륨 마운트 SQLite 데이터베이스 경로
DATABASE_URL=file:/data/udn.db

# 운영 OAuth 소셜 로그인 (Google, Naver 운영 콘솔 승인된 리다이렉트 URI 설정)
AUTH_GOOGLE_ID=production-google-client-id
AUTH_GOOGLE_SECRET=production-google-client-secret
AUTH_NAVER_ID=production-naver-client-id
AUTH_NAVER_SECRET=production-naver-client-secret

# NAVER Cloud SENS Biz Message (Lightsail 서버 환경에만 비밀값 설정)
SENS_ALIMTALK_SERVICE_ID=service-id
SENS_ALIMTALK_CHANNEL_ID=@studioudn
SENS_ACCESS_KEY=production-ncloud-access-key
SENS_SECRET_KEY=production-ncloud-secret-key

# 우체국 국내우편물 종적조회 OpenAPI (운영 서버 전용)
EPOST_SERVICE_KEY=replace-with-epost-service-key
EPOST_POLLING_TOKEN=generate-a-long-random-secret

# 나이스페이 운영 상점의 Server 승인 키 (서버 전용)
NICEPAY_CLIENT_ID=replace-with-production-nicepay-client-key
NICEPAY_SECRET_KEY=replace-with-production-nicepay-secret-key
